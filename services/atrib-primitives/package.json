{
  "name": "@atrib/primitives-runtime",
  "version": "0.2.15",
  "description": "Private local MCP runtime for atrib's verifiable action layer. Exposes all cognitive primitives from one process.",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "atrib-primitives": "./dist/index.js"
  },
  "scripts": {
    "build": "rm -rf dist && tsc && chmod +x dist/index.js",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@atrib/daemon": "workspace:*",
    "@atrib/attest": "workspace:*",
    "@atrib/recall": "workspace:*",
    "@atrib/summarize": "workspace:*",
    "@atrib/verify": "workspace:*",
    "@modelcontextprotocol/client": "^2.0.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@modelcontextprotocol/server": "^2.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  },
  "files": [
    "dist"
  ]
}
