{
  "name": "@atrib/memory-tool",
  "version": "0.2.22",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "description": "Memory Tool wrapper for atrib's verifiable action layer. Signs memory commands while leaving storage under the host's control.",
  "author": "atrib <hello@atrib.dev>",
  "license": "Apache-2.0",
  "homepage": "https://atrib.dev",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "anthropic",
    "claude",
    "agent-memory",
    "memory",
    "memory-tool",
    "verifiable",
    "atrib"
  ],
  "scripts": {
    "build": "tsc",
    "smoke": "tsx examples/filesystem-smoke.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && pnpm typecheck:compat",
    "typecheck:compat": "tsc --ignoreConfig --noEmit --target ES2022 --module ESNext --moduleResolution Bundler --types node --strict --exactOptionalPropertyTypes --skipLibCheck test/index.test.ts test/sdk-compat.test.ts examples/filesystem-smoke.ts",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@atrib/mcp": "workspace:*",
    "canonicalize": "^5.1.0"
  },
  "peerDependencies": {
    "@anthropic-ai/sdk": ">=0.100.1"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@types/node": "^26.6.5",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/creatornader/atrib.git",
    "directory": "packages/memory-tool"
  },
  "engines": {
    "node": ">=22"
  }
}
